          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('API code 200', function () { pm.expect(response.code).to.eql(200); });",
                  "pm.test('result est un tableau', function () { pm.expect(response.result).to.be.an('array'); });",
                  "const title = pm.collectionVariables.get('livreTitle');",
                  "const found = response.result.find(x => x.titre === title);",
                  "pm.test('livre créé retrouvé', function () { pm.expect(found, 'livre créé').to.exist; });",
                  "if (found) {",
                  "  pm.collectionVariables.set('createdLivreId', found.id);",
                  "  pm.collectionVariables.set('createdLivreDeleteJson', encodeURIComponent(JSON.stringify({ id: found.id })));",
                  "  pm.collectionVariables.set('createdLivreFilterJson', encodeURIComponent(JSON.stringify({ id: found.id })));",
                  "}"
                ]
              }
            }
          ]
        },
