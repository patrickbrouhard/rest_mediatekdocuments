      "name": "01 - Authentification applicative",
      "item": [
        {
          "name": "01.01 - POST authentification utilisateur",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/authentification",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "champs",
                  "value": "{{authJson}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('API code 200', function () { pm.expect(response.code).to.eql(200); });",
                  "pm.test('utilisateur authentifié ou résultat exploitable', function () { pm.expect(response).to.have.property('result'); });",
                  "pm.test('le mot de passe n’est pas renvoyé', function () { if (response.result && typeof response.result === 'object') { pm.expect(response.result).to.not.have.property('pwd'); } });"
                ]
              }
            }
          ]
        }
      ]
    },
