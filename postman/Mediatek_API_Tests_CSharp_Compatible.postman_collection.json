                  "pm.test('result est un tableau', function () { pm.expect(response.result).to.be.an('array'); });",
                  "const result = response.result || [];",
                  "pm.test('au moins un exemplaire créé pour le livre', function () { pm.expect(result.length).to.be.above(0); });",
