        {
          "name": "02.04 - POST commande pour le livre créé",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/commandedocument",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "champs",
                  "value": "{{commandeLivreJson}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const idLivre = pm.collectionVariables.get('createdLivreId');",
                  "if (!idLivre) { throw new Error('createdLivreId absent : exécuter la requête de capture du livre avant celle-ci.'); }",
                  "pm.collectionVariables.set('commandeLivreJson', JSON.stringify({ dateCommande: '2026-04-10', montant: '32.00', nbExemplaire: '1', idLivreDvd: idLivre, idSuivi: '1' }));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('API code 200', function () { pm.expect(response.code).to.eql(200); });",
                  "pm.test('result > 0', function () { pm.expect(Number(response.result)).to.be.above(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02.05 - GET commandes livres - capturer l'ID de commande",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/commandedocument/{{commandeLivreFilterJson}}"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('API code 200', function () { pm.expect(response.code).to.eql(200); });",
                  "pm.test('result est un tableau', function () { pm.expect(response.result).to.be.an('array'); });",
                  "const idLivre = pm.collectionVariables.get('createdLivreId');",
                  "const matches = response.result.filter(x => x.idLivreDvd === idLivre);",
                  "matches.sort((a, b) => String(b.id).localeCompare(String(a.id)));",
                  "const found = matches[0];",
                  "pm.test('commande de document créée retrouvée', function () { pm.expect(found, 'commande créée').to.exist; });",
                  "if (found) {",
                  "  pm.collectionVariables.set('createdCommandeLivreId', found.id);",
                  "  pm.collectionVariables.set('createdCommandeLivreDeleteJson', encodeURIComponent(JSON.stringify({ id: found.id })));",
                  "  pm.collectionVariables.set('commandeLivreUpdateJson', JSON.stringify({ dateCommande: '2026-04-12', montant: 50, idLivreDvd: idLivre, nbExemplaire: 1, idSuivi: 3 }));",
                  "}"
                ]
              }
            }
          ]
        },
