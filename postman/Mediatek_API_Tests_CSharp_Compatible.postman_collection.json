        {
          "name": "00.01 - Initialiser les variables + GET genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/genre"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "const shortNumber = Number(suffix.slice(-6));",
                  "pm.collectionVariables.set('runSuffix', suffix);",
                  "pm.collectionVariables.set('testPrefix', 'POSTMAN_E2E_' + suffix);",
                  "pm.collectionVariables.unset('createdLivreId');",
                  "pm.collectionVariables.unset('createdCommandeLivreId');",
                  "pm.collectionVariables.unset('createdLivreExemplaireNumero');",
                  "pm.collectionVariables.unset('createdDvdId');",
                  "pm.collectionVariables.unset('createdRevueId');",
                  "pm.collectionVariables.unset('createdAbonnementId');",
                  "pm.collectionVariables.set('commandeLivreFilterJson', encodeURIComponent(JSON.stringify({ typemedia: 'livre' })));",
                  "pm.collectionVariables.set('commandeDvdFilterJson', encodeURIComponent(JSON.stringify({ typemedia: 'dvd' })));",
                  "pm.collectionVariables.set('authJson', JSON.stringify({ login: 'adm', password: 'test' }));",
                  "pm.collectionVariables.set('livreTitle', 'POSTMAN_E2E_LIVRE_' + suffix);",
                  "pm.collectionVariables.set('livreJson', JSON.stringify({ titre: pm.collectionVariables.get('livreTitle'), image: '', idRayon: 'LV001', idPublic: '00002', idGenre: '10006', ISBN: '9780000000000', auteur: 'Postman', collection: 'Tests API' }));",
                  "pm.collectionVariables.set('livreUpdateJson', JSON.stringify({ titre: pm.collectionVariables.get('livreTitle') + '_MODIFIE', collection: 'Tests API modifies' }));",
                  "pm.collectionVariables.set('dvdTitle', 'POSTMAN_E2E_DVD_' + suffix);",
                  "pm.collectionVariables.set('dvdJson', JSON.stringify({ titre: pm.collectionVariables.get('dvdTitle'), image: '', idRayon: 'DF001', idPublic: '00003', idGenre: '10002', realisateur: 'Postman', duree: 120, synopsis: 'DVD créé par la collection de tests Postman.' }));",
                  "pm.collectionVariables.set('dvdUpdateJson', JSON.stringify({ titre: pm.collectionVariables.get('dvdTitle') + '_MODIFIE', duree: 125 }));",
                  "pm.collectionVariables.set('revueTitle', 'POSTMAN_E2E_REVUE_' + suffix);",
                  "pm.collectionVariables.set('revueJson', JSON.stringify({ titre: pm.collectionVariables.get('revueTitle'), image: '', idRayon: 'PR002', idPublic: '00002', idGenre: '10016', periodicite: 'MS', delaiMiseADispo: 15 }));",
                  "pm.collectionVariables.set('revueUpdateJson', JSON.stringify({ titre: pm.collectionVariables.get('revueTitle') + '_MODIFIE', periodicite: 'HB' }));",
                  "pm.collectionVariables.set('testExemplaireNumero', String(900000 + (shortNumber % 99999)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();",
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('API code 200', function () { pm.expect(response.code).to.eql(200); });",
                  "pm.test('result est un tableau', function () { pm.expect(response.result).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
